# camie-immich-tagger configuration.
# Copy to .env and edit. Keep the file readable only by its owner:
#   cp .env.example .env && chmod 600 .env

# ---- Image sources ----
# Colon-separated list of directories to scan (the paths as seen by THIS machine).
CAMIE_SCAN_DIRS=/mnt/media

# ---- Paths ----
# Directory containing camie-tagger-v2.onnx and camie-tagger-v2-metadata.json.
# Defaults to <project>/models
CAMIE_MODEL_DIR=

# exiftool binary. Defaults to whatever is on PATH.
CAMIE_EXIFTOOL=exiftool

# JSON run state (processed images, Tier 0 queue and progress).
# Defaults to <project>/data
CAMIE_DATA_DIR=

# Rotating log files. Defaults to <project>/logs
CAMIE_LOG_DIR=
CAMIE_LOG_LEVEL=INFO
# Max size per log file in megabytes, and how many rotated copies to keep.
CAMIE_LOG_MAX_MB=10
CAMIE_LOG_BACKUPS=5

# ---- Immich ----
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=
# Comma-separated External Library UUIDs (NOT the display name).
# Find them with: curl -H "x-api-key: $IMMICH_API_KEY" "$IMMICH_URL/api/libraries"
IMMICH_LIBRARY_IDS=

# ---- Inference ----
# Confidence threshold for writing a tag (0.0 - 1.0).
CAMIE_THRESHOLD=0.5
# auto | intel | nvidia | amd | cpu
CAMIE_DEVICE=auto

# ---- SauceNAO (Tier 0 reverse search, optional) ----
SAUCENAO_API_KEY=
# Minimum SauceNAO similarity percentage required to accept a match.
CAMIE_TIER0_MIN_SIMILARITY=88
# Maximum SauceNAO searches per run (free tier is roughly 100/day).
CAMIE_TIER0_DAILY_CAP=100
# Seconds to wait between SauceNAO searches.
CAMIE_TIER0_INTERVAL=18
